\@writefile{lof}{\defcounter {refsection}{0}\relax }\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces The spectrum of the transverse momentum of the jet selected in a SMEFT variant of the cH(ZZ$\tmspace  +\thinmuskip {.1667em}\rightarrow 4\mu $)\tmspace  +\thinmuskip {.1667em}analysis. Contributions from the $\hat  {O}_{cG}$ operator, simulated for a nominal value of $\tilde  {C}_{cG}$ = 0.5 TeV$^{-2}$, are scaled by a factor 10 to improve visibility and can be clearly see to produce jets at high transverse momenta. \relax }}{78}{figure.caption.63}\protected@file@percent }
\newlabel{fig:jet_ptEFT}{{5.2}{78}{The spectrum of the transverse momentum of the jet selected in a SMEFT variant of the \cHZZ analysis. Contributions from the $\hat {O}_{cG}$ operator, simulated for a nominal value of $\tilde {C}_{cG}$ = 0.5 TeV$^{-2}$, are scaled by a factor 10 to improve visibility and can be clearly see to produce jets at high transverse momenta. \relax }{figure.caption.63}{}}
\@writefile{lof}{\defcounter {refsection}{0}\relax }\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces Figure showing the 30 leading uncertainty sources in a fit of $\tilde  {C}_{cG}$, orderd by their relative impact on the fit. In the left panel the nuisance parameter names can be seen. In the central panel, the fitted nuisance parameter values as well as their so-called pulls are shown. On the right, the $\Delta \hat  {r}_i$ values can be seen for the $\pm \sigma $ variations associated with each nuisance parameter. Here $\hat  {r}$ represents the signal strength associated with the expected upper limit that is set for $\tilde  {C}_{cG}$.\relax }}{79}{figure.caption.64}\protected@file@percent }
\newlabel{fig:ImpactsEFT}{{5.3}{79}{Figure showing the 30 leading uncertainty sources in a fit of $\tilde {C}_{cG}$, orderd by their relative impact on the fit. In the left panel the nuisance parameter names can be seen. In the central panel, the fitted nuisance parameter values as well as their so-called pulls are shown. On the right, the $\Delta \hat {r}_i$ values can be seen for the $\pm \sigma $ variations associated with each nuisance parameter. Here $\hat {r}$ represents the signal strength associated with the expected upper limit that is set for $\tilde {C}_{cG}$.\relax }{figure.caption.64}{}}
