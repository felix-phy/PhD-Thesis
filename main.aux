\@writefile{lof}{\defcounter {refsection}{0}\relax }\@writefile{lof}{\contentsline {figure}{\numberline {2.3}{\ignorespaces A Feynman diagram showing representing contributions to the cH process that are not sensitive to $y_{\mathrm  {c}}$, given the absence of an interaction between the Higgs boson and the charm quark. The quark loop seen in the middle is strongly dominanted by top quarks, given their strong coupling to the Higgs boson in comparison to quarks of other flavours. Accordingly, the contribution from charm quarks in this loop is negligible. The corresponding diagrams with anti-particles are implied.\relax }}{11}{figure.caption.10}\protected@file@percent }
\newlabel{fig:cHFeynmanInsensitive}{{2.3}{11}{A Feynman diagram showing representing contributions to the cH process that are not sensitive to \yc , given the absence of an interaction between the Higgs boson and the charm quark. The quark loop seen in the middle is strongly dominanted by top quarks, given their strong coupling to the Higgs boson in comparison to quarks of other flavours. Accordingly, the contribution from charm quarks in this loop is negligible. The corresponding diagrams with anti-particles are implied.\relax }{figure.caption.10}{}}
\@writefile{lof}{\defcounter {refsection}{0}\relax }\@writefile{lof}{\contentsline {figure}{\numberline {2.4}{\ignorespaces Transverse momentum of the parton produced alongside a Higgs boson in a \textsf  {Madgraph5\_aMC$@$NLO} \cite {MadGraph} simulation of the cH process within the CMS detector, which typically takes on very small values. Since jets at very low transverse momenta cannot be well reconstructed in experiments such as the CMS detector, a minimum $p_{T}$\tmspace  +\thinmuskip {.1667em} requirement is introduced in the simulation to limit the simulation of events that are not expected to be experimentally accessible. This results in the appearance of a peak in the [25, 50] GeV bin of the distribution.\relax }}{11}{figure.caption.11}\protected@file@percent }
\newlabel{fig:JetPtcH}{{2.4}{11}{Transverse momentum of the parton produced alongside a Higgs boson in a \textsf {Madgraph5\_aMC$@$NLO} \cite {MadGraph} simulation of the cH process within the CMS detector, which typically takes on very small values. Since jets at very low transverse momenta cannot be well reconstructed in experiments such as the CMS detector, a minimum \pt \, requirement is introduced in the simulation to limit the simulation of events that are not expected to be experimentally accessible. This results in the appearance of a peak in the [25, 50] GeV bin of the distribution.\relax }{figure.caption.11}{}}
