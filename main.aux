\@writefile{lof}{\defcounter {refsection}{0}\relax }\@writefile{lof}{\contentsline {figure}{\numberline {2.3}{\ignorespaces Transverse momentum of the parton produced alongside a Higgs boson in a \textsf  {Madgraph5\_aMC$@$NLO} \cite {MadGraph} simulation of the cH process within the CMS detector, which typically takes on very small values. However, since jets at very low transverse momentum cannot be well reconstructed in experiments such as the CMS detector, a minimum $p_{T}$\tmspace  +\thinmuskip {.1667em} requirement is introduced in the simulation to reduce the reconstruction efficiency loss associated with this effect. This results in the appearance of a peak in the [25, 50] GeV bin of the distribution.\relax }}{11}{figure.caption.7}\protected@file@percent }
\newlabel{fig:JetPtcH}{{2.3}{11}{Transverse momentum of the parton produced alongside a Higgs boson in a \textsf {Madgraph5\_aMC$@$NLO} \cite {MadGraph} simulation of the cH process within the CMS detector, which typically takes on very small values. However, since jets at very low transverse momentum cannot be well reconstructed in experiments such as the CMS detector, a minimum \pt \, requirement is introduced in the simulation to reduce the reconstruction efficiency loss associated with this effect. This results in the appearance of a peak in the [25, 50] GeV bin of the distribution.\relax }{figure.caption.7}{}}
